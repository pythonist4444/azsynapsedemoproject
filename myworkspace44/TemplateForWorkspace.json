			"type": "string",
			"metadata": "Workspace name",
			"defaultValue": "myworkspace44"
		},
		"myworkspace44-WorkspaceDefaultSqlServer_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'myworkspace44-WorkspaceDefaultSqlServer'",
			"defaultValue": "Integrated Security=False;Encrypt=True;Connection Timeout=30;Data Source=tcp:myworkspace44.sql.azuresynapse.net,1433;Initial Catalog=@{linkedService().DBName}"
		},
		"myworkspace44-WorkspaceDefaultStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://contosolakeadls2.dfs.core.windows.net"
		}
	},
