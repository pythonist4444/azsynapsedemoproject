							"df = spark.read.load('abfss://users@contosolakeadls2.dfs.core.windows.net/NYCTaxi/PassengerCountStats_parquetformat/part-00000-00614c73-6792-419a-918a-eaff84a10e0e-c000.snappy.parquet', format='parquet')\r\n",
