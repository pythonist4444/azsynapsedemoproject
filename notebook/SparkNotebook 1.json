					"%%pyspark\r\n",
					"df = spark.read.load('abfss://users@contosolakeadls2.dfs.core.windows.net/NYCTripSmall.parquet', format='parquet')\r\n",
					"display(df.limit(10))"
				],
				"execution_count": 1
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					}
				},
				"source": [
					"%%pyspark\r\n",
					"df.printSchema()"
				],
				"execution_count": 2
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					}
				},
				"source": [
					"%%pyspark\r\n",
					"spark.sql(\"CREATE DATABASE IF NOT EXISTS nyctaxi\")\r\n",
					"df.write.mode(\"overwrite\").saveAsTable(\"nyctaxi.trip\")"
				],
				"execution_count": 3
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					},
					"collapsed": false
				},
				"source": [
					"%%pyspark\r\n",
					"df = spark.sql(\"SELECT * FROM nyctaxi.trip\")\r\n",
					"display(df.limit(20))"
				],
				"execution_count": 6
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					},
					"collapsed": false
				},
				"source": [
					"%%pyspark\r\n",
					"df = spark.sql(\"\"\"\r\n",
					"   SELECT passenger_count,\r\n",
					"       SUM(trip_distance) as SumTripDistance,\r\n",
					"       AVG(trip_distance) as AvgTripDistance\r\n",
					"   FROM nyctaxi.trip\r\n",
					"   WHERE trip_distance > 0 AND passenger_count > 0\r\n",
					"   GROUP BY passenger_count\r\n",
					"   ORDER BY passenger_count\r\n",
					"\"\"\") \r\n",
					"display(df)\r\n",
					"df.write.saveAsTable(\"nyctaxi.passengercountstats\")"
				],
				"execution_count": 7
			},
